# Copy to `.env` on the VPS (chmod 600 .env). Never commit `.env`.

# ---------- domain / TLS (docker-compose.web.yaml) ----------
# Primary host served by Caddy; the apex (narsilstudio.io) is redirected to it.
DOMAIN=www.narsilstudio.io
APEX_DOMAIN=narsilstudio.io
# Let's Encrypt expiry notices go here.
ACME_EMAIL=you@narsilstudio.io
SITE_URL=https://www.narsilstudio.io

# ---------- frontend (NEXT_PUBLIC_* are inlined at BUILD time) ----------
# Changing any of these requires: docker compose -f docker-compose.web.yaml up -d --build
NEXT_PUBLIC_MAINTENANCE_MODE=true
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/your-company
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@your-channel

# ---------- full stack only (docker-compose.yaml) ----------
POSTGRES_PASSWORD=change-me
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
